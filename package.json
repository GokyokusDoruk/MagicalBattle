{
  "name": "magicalbattle",
  "private": true,
  "version": "0.1.0",
  "description": "MagicalBattle - 2D/3D hibrit açık dünya RPG (monorepo)",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "build:server": "npm run build -w server",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server",
    "test": "npm test --workspaces --if-present",
    "dev:db": "npm run dev:db -w server"
  }
}
