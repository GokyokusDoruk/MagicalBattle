# Sunucuda: bu dosyayı ".env" olarak kopyala ve değerleri doldur. ".env" asla git'e eklenmez.

# Veritabanı şifresi (uzun ve rastgele; sadece harf ve rakam kullanmak URL'de sorun çıkarmaz)
POSTGRES_PASSWORD=

# Oturum çerezlerini imzalayan gizli anahtar, en az 32 karakter. Üretmek için:
#   openssl rand -base64 48
JWT_SECRET=

# Oyunun yayınlandığı adres(ler), virgülle ayrılır
CORS_ORIGINS=https://magicalbattle.dorukplays.com

# Çerezin geçerli olacağı alan (başında nokta)
COOKIE_DOMAIN=.dorukplays.com

# API'nin adresi (Caddy bu alan için sertifika alır)
API_DOMAIN=api.dorukplays.com
